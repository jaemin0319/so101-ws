# SO-101 실행 설정 — 이 저장소를 만든 컴퓨터(2026-10, Ubuntu 24.04, RTX 5060 Laptop)에서 실제로 확인한 값 그대로다.
# scripts/activate.sh·teleop.sh·rollout.sh가 SO101_REPO(저장소 경로)를 정한 뒤 불러온다. 직접 불러올 때:
#   export SO101_REPO=~/so101-ws; set -a; . config/so101.env; set +a
# 토큰·비밀번호는 넣지 않는다(Hugging Face 로그인은 `hf auth login`).
# 다른 PC나 다른 USB 포트에 꽂으면 카메라 경로가 달라진다 → scripts/cam_diag.py로 확인하고 아래 값을 고친다.

# ---- conda 환경 ----
SO101_ENV_NAME=${SO101_ENV_NAME:-jammin_so-arm}

# ---- 로봇 팔(USB 시리얼, CH343 보드 1a86:55d3) ----
# by-id = 보드 시리얼 번호 기준이라 재연결·다른 USB 포트·다른 PC에서도 같다.
# 2026-10-23 구분: 모터 Present_Voltage(읽기 전용)로 판별. follower 12.0~12.2V(12V 전원), leader 6.1~6.2V(5V 전원)
#   다시 확인: python scripts/find_arms.py
SO101_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90151504-if00
SO101_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90151751-if00
# 장치 ID = 보정 파일 이름(calibration/robots/so_follower/<ID>.json, calibration/teleoperators/so_leader/<ID>.json)
SO101_FOLLOWER_ID=so101_follower
SO101_LEADER_ID=so101_leader

# ---- 카메라(Innomaker U20CAM-720P 2대, 0c45:6367) ----
# 두 카메라의 USB 시리얼이 같아(SN0001) /dev/v4l/by-id는 하나만 생기고 재부팅마다 가리키는 장치가 바뀐다(실측).
# 그래서 USB 포트 위치 기준 by-path를 쓴다. 이 컴퓨터: USB 2.0 허브(Genesys 05e3:0610)의 2.4번 = front, 2.1번 = wrist.
#   (허브의 2.2번 = follower 보드, 2.3번 = leader 보드). 같은 구멍에 꽂아야 경로가 유지된다.
SO101_CAM_FRONT=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2.4:1.0-video-index0
SO101_CAM_WRIST=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2.1:1.0-video-index0
# 학습 데이터(jammin0319/so101_ball_to_bowl_v1)와 같게: 640x480 30fps, front만 180도 회전
SO101_CAM_WIDTH=640
SO101_CAM_HEIGHT=480
SO101_CAM_FPS=30
SO101_CAM_FRONT_ROTATION=180
# 두 카메라가 USB 2.0 허브 하나를 같이 써서 기본 YUYV(비압축)면 front 프레임 150장 중 31~36장이 깨짐(실측).
# MJPG면 0장. lerobot 카메라 설정에 fourcc: MJPG 필수.
SO101_CAM_FOURCC=MJPG

# ---- 데이터 위치(저장소 밖, 이 컴퓨터와 같은 폴더) ----
SO101_WORK_DIR=$HOME/jammin_so101_local
SO101_MODEL_DIR=$SO101_WORK_DIR/models
SO101_DATA_DIR=$SO101_WORK_DIR/datasets
HF_HOME=$SO101_WORK_DIR/hf_home
# LeRobot 보정 파일 위치 = 이 저장소의 calibration/(다시 보정하면 여기 파일이 바뀐다 → git diff로 확인 후 커밋)
HF_LEROBOT_CALIBRATION=$SO101_REPO/calibration

# ---- Hugging Face(공개 repo, 로그인 불필요). revision = 2026-10-23에 받은 커밋 ----
SO101_MODEL_REPO_ID=jammin0319/act_so101_ball_to_bowl_v1
SO101_MODEL_REVISION=dd639021a17f8e7584baa100d40a5127f72ba14f
SO101_DATASET_REPO_ID=jammin0319/so101_ball_to_bowl_v1
SO101_DATASET_REVISION=9a4f2b86df9c171c725fbc7c2ce9af37e4b35f08
# rollout 기본 체크포인트(020000~140000 중)
SO101_CHECKPOINT=100000

# ---- 학습 로깅 ----
WANDB_MODE=disabled
