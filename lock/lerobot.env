# SO-101 환경의 버전 기준. scripts/install.sh와 scripts/so101.py가 KEY=VALUE로 파싱한다(셸에서 source하지 않음).
# 값을 바꾸면 `scripts/install.sh --relock`으로 lock/uv.lock을 다시 만들고 검증해야 한다.

LEROBOT_REPO=https://github.com/huggingface/lerobot.git
LEROBOT_TAG=v0.6.1
LEROBOT_SHA=7e241bd630a3719a56157a497ce5d08f244784f1
LEROBOT_VERSION=0.6.1

# Python minor 버전. 시스템 python3.12를 쓴다(uv가 Python을 내려받지 않음).
PYTHON_MINOR=3.12

# uv 고정 바이너리(GitHub 릴리스 자산 + 공식 .sha256 파일로 검증).
UV_VERSION=0.12.23
UV_ASSET=uv-x86_64-unknown-linux-gnu.tar.gz
UV_SHA256=9167d72b3319674b6303c4cbe071854bba13ebdf3d76b1a7cbdc175471fb66d6

# torch/torchvision만 이 인덱스에서 받는다(lock/pyproject.toml의 tool.uv.sources). 나머지는 PyPI.
TORCH_CPU_INDEX=https://download.pytorch.org/whl/cpu

# 하드웨어 원본 참조(설치에는 쓰지 않음).
SOARM_REPO=https://github.com/TheRobotStudio/SO-ARM100
SOARM_SHA=a758567c3978dfeefe282ede0500085a48fe8f78
